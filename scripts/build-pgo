#!/usr/bin/env bash
set -euo pipefail

install_requested=false
if (( $# == 1 )) && [[ $1 == --install ]]; then
    install_requested=true
elif (( $# )); then
    echo 'Usage: ./scripts/build-pgo [--install]' >&2
    exit 1
fi

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo"
host=$(rustc -vV | sed -n 's/^host: //p')
llvm="$(rustc --print sysroot)/lib/rustlib/$host/bin/llvm-profdata"
if [[ ! -x "$llvm" ]]; then
    echo 'Install matching tools: rustup component add llvm-tools' >&2
    exit 1
fi
if [[ -x "$HOME/.venv/bin/python" ]]; then
    python=("$HOME/.venv/bin/python")
else
    python=(uv run --offline --script)
fi
if command -v sha256sum >/dev/null; then
    hash=(sha256sum)
else
    hash=(shasum -a 256)
fi

out="$repo/target/pgo"
mkdir -p "$out"
lock="$out/.build-lock"
if ! mkdir "$lock" 2>/dev/null; then
    echo "PGO build lock exists: $lock; check for an active build" >&2
    exit 1
fi
trap 'rmdir -- "$lock"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

signature=$(
    {
        rustc -vV
        "${hash[@]}" Cargo.toml Cargo.lock scripts/build-pgo \
            scripts/pgo-workload.py
        find src -type f -exec "${hash[@]}" {} + | LC_ALL=C sort
    } | "${hash[@]}" | cut -d ' ' -f 1
)
training="$out/.training"
if [[ ! -f "$training/signature" ]] \
    || [[ $(<"$training/signature") != "$signature" ]]; then
    rm -rf -- "$training"
    mkdir -p "$training/profiles"
    printf '%s\n' "$signature" > "$training/signature"
fi
export CARGO_TARGET_DIR="$repo/target/pgo-build"
unset CARGO_ENCODED_RUSTFLAGS
binary="$CARGO_TARGET_DIR/$host/release/cryptty"

if [[ ! -f "$training/ready" ]]; then
    printf 'PGO: building the instrumented terminal\n'
    export RUSTFLAGS="-Cprofile-generate=$training/profiles"
    cargo build --release --locked --target "$host"
    rm -f -- "$training"/profiles/*.profraw "$training"/*.ok
    printf 'PGO: training automatic and software rendering in two windows\n'
    for renderer in auto software; do
        marker="$training/$renderer.ok"
        LLVM_PROFILE_FILE="$training/profiles/$renderer-%p-%m.profraw" \
            "$binary" --renderer "$renderer" -- \
            "${python[@]}" "$repo/scripts/pgo-workload.py" "$marker"
        if [[ ! -f "$marker" ]]; then
            echo "PGO training did not finish: $renderer" >&2
            exit 1
        fi
    done
    profile=$(mktemp "$training/merged.XXXXXX")
    "$llvm" merge -o "$profile" "$training"/profiles/*.profraw
    printf '%s\n' "${profile##*/}" > "$training/ready.tmp"
    mv "$training/ready.tmp" "$training/ready"
else
    profile_name=$(<"$training/ready")
    if [[ $profile_name != merged.* || $profile_name == */* ]] \
        || [[ ! -s "$training/$profile_name" ]]; then
        echo "PGO checkpoint is incomplete: $training" >&2
        exit 1
    fi
    profile="$training/$profile_name"
    printf 'PGO: resuming the optimized build with the saved profile\n'
fi

printf 'PGO: building the optimized terminal\n'
export RUSTFLAGS="-Cprofile-use=$profile"
RUSTFLAGS+=' -Cllvm-args=-pgo-warn-missing-function'
cargo build --release --locked --target "$host"
if [[ $install_requested == true ]]; then
    install_args=()
    if [[ $(uname -s) == Linux ]]; then
        install_args=(--root "${PREFIX:-$HOME/.local}")
    fi
    cargo install --path "$repo" --locked --target "$host" --force \
        "${install_args[@]}"
fi
cp "$binary" "$training/cryptty"
cp "$profile" "$training/cryptty.profdata"
mv -f "$training/cryptty" "$out/cryptty"
mv -f "$training/cryptty.profdata" "$out/cryptty.profdata"
rm -rf -- "$training"
printf 'PGO: ready: %s/cryptty\n' "$out"
